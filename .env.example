APP_NAME=AI Support Operations Copilot
ENVIRONMENT=development
DATABASE_URL=sqlite:///./support_copilot.db

# Analysis provider selection.
# Keep 'mock' for normal local development and CI.
ANALYSIS_PROVIDER=mock

# Required only when ANALYSIS_PROVIDER=openai.
# Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
